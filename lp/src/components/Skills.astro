<style>
  section {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    margin-top: 100px;
  }
  .skill {
    margin-top: 62px;
    display: flex;
    width: 100%;
    align-items: flex-start;
    justify-content: space-evenly;
    gap: 20px;
    flex-wrap: wrap;
  }
  .skill-container {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    border: 1px solid rgba(128, 128, 128, 0.356);
    padding: 24px 50px;
    border-radius: 10px;
    gap: 20px;
  }
  ul {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  li {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 20px;
    margin-bottom: 10px;
  }
  li h1 {
    line-height: 16px;
    margin-bottom: 4px;
  }
  li:nth-child(odd) {
    margin-right: 20px;
  }
  img {
    height: 20px;
  }
  span {
    margin-bottom: 24px;
  }
  li h1 {
    font-size: 20px;
  }
  li span {
    font-size: 13px;
  }
  @media (max-width: 820px) {
    .skill {
      flex-direction: column;
      gap: 48px;
      align-items: center;
    }
  }
</style>
